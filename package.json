{
  "name": "mesh-gpu-client",
  "version": "0.1.0",
  "private": true,
  "description": "MeshGPU browser client \u2014 WebGPU capability probing, serverless WebRTC pairing, and a P2P tensor transport.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:manual": "playwright test tests/e2e-manual-handshake.spec.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.78",
    "html5-qrcode": "^2.3.8",
    "lz-string": "^1.5.0",
    "peerjs": "^1.5.5",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@webgpu/types": "^0.1.71",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
